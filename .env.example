# Bu faylni nusxalab .env.local qiling (yoki Vercel > Settings > Environment Variables).
# Bu qiymatlar faqat serverda ishlaydi — saytga kirgan odam ularni ko'ra olmaydi.

# @BotFather dan olingan token
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Arizalar tushadigan chat ID.
# O'zingizga: botga /start yozing, keyin
#   https://api.telegram.org/bot<TOKEN>/getUpdates  manzilidan chat.id ni oling.
# Guruhga: botni guruhga qo'shing, guruh ID minus bilan boshlanadi (-1001234567890).
CHAT_ID=-1001234567890
